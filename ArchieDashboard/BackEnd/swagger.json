{
  "swagger": "2.0",
  "info": {
    "title": "Archie Dashboard API",
    "version": "1.0.0",
    "description": "Authenticated metrics API. Send `Authorization: Bearer <Auth0 access token>` on every `/api` request."
  },
  "basePath": "/",
  "schemes": ["https", "http"],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer access token from Auth0"
    }
  },
  "security": [{ "Bearer": [] }],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "API process is up"
          }
        }
      }
    },
    "/api/v1/database/metrics": {
      "get": {
        "summary": "Backup metrics",
        "responses": {
          "200": { "description": "Metrics payload" },
          "401": { "description": "Missing or invalid token" }
        }
      },
      "post": {
        "summary": "Backup metrics with filters",
        "parameters": [
          {
            "in": "body",
            "name": "filter",
            "schema": { "$ref": "#/definitions/MetricsFilter" }
          }
        ],
        "responses": {
          "200": { "description": "Metrics payload" },
          "400": { "description": "Invalid body" },
          "401": { "description": "Missing or invalid token" }
        }
      }
    },
    "/api/v1/database/metrics/statistics": {
      "get": { "summary": "Statistics", "responses": { "200": { "description": "OK" } } },
      "post": {
        "summary": "Statistics with filters",
        "parameters": [
          {
            "in": "body",
            "name": "filter",
            "schema": { "$ref": "#/definitions/MetricsFilter" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/database/metrics/week": {
      "get": { "summary": "Week metrics", "responses": { "200": { "description": "OK" } } },
      "post": {
        "summary": "Week metrics with filters",
        "parameters": [
          {
            "in": "body",
            "name": "filter",
            "schema": { "$ref": "#/definitions/MetricsFilter" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/database/metrics/grid": {
      "get": { "summary": "Company grid", "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/database/metrics/list": {
      "get": { "summary": "Company names", "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/predict": {
      "post": {
        "summary": "Linear-regression forecast",
        "parameters": [
          {
            "in": "body",
            "name": "filter",
            "schema": { "$ref": "#/definitions/MetricsFilter" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/settings/{id}": {
      "get": {
        "summary": "Settings (not implemented)",
        "parameters": [{ "in": "path", "name": "id", "required": true, "type": "string" }],
        "responses": { "501": { "description": "Not implemented" } }
      }
    }
  },
  "definitions": {
    "MetricsFilter": {
      "type": "object",
      "properties": {
        "companies": { "type": "array", "items": { "type": "string" }, "example": ["acme"] },
        "fromDate": { "type": "number" },
        "toDate": { "type": "number" },
        "dates": { "type": "array", "items": { "type": "number" } },
        "months": { "type": "integer", "minimum": 1, "maximum": 24 }
      }
    }
  }
}
